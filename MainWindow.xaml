<Window x:Class="CyberSecurityBot1GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberSecurity Bot" Height="500" Width="1000"
        Background="Black">

    <Grid>

        <TextBlock Text=" CYBERSECURITY BOT"
                   Foreground="Cyan"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>

        <TextBox x:Name="ChatDisplay"
         Margin="20,80,20,120"
         IsReadOnly="True"
         TextWrapping="Wrap"
         VerticalScrollBarVisibility="Auto"
         FontSize="16"
         Background="#111"
         Foreground="White"
         BorderBrush="Cyan"/>

        <TextBox x:Name="UserInput"
         Margin="20,400,150,40"
         FontSize="16"
         Background="#222"
         Foreground="White"
         BorderBrush="Cyan"/>

        <Button Content="Send"
        Width="90"
        Height="35"
         HorizontalAlignment="Left"     
         VerticalAlignment="Top"
        Margin="860,385,0,0"
        Background="Cyan"
        Foreground="Black"
        FontWeight="Bold"
        Click="SendButton_Click"/>

    </Grid>
</Window>